{
  "name": "oriafuture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "npm run lint && npm test && vite build",
    "preview": "npm run build && vite preview --host 127.0.0.1",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "npm run build && wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:typegen": "wrangler types",
    "test": "tsx --test worker/*.test.ts src/services/*.test.ts",
    "check:migrations": "node scripts/verify-migrations.mjs",
    "check:demo-finance": "node scripts/verify-demo-finance-seed.mjs",
    "check:security-boundaries": "node scripts/check-security-boundaries.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
