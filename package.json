{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "npm run build && vite preview --host 127.0.0.1",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "npm run build && wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:typegen": "wrangler types",
    "test": "tsx --test worker/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^5.3.0",
    "dotenv": "^18.0.10",
    "motion": "^14.12.0",
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
