{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiacc-ecommerce-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
