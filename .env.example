# Browser-safe Supabase configuration. The publishable key is intended for public clients.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only values must never use the VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Development-only opt-in for the legacy seeded demo repository.
# Never enable this on a production deployment.
# NEXUS_DEMO_MODE=true
