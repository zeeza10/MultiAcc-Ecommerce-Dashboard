# Local Wrangler runtime variables. Never commit the real .dev.vars file.
API_ORIGIN=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# Server-only eBay Sandbox credentials. Configure as Worker Secrets, not vars.
# EBAY_SANDBOX_CLIENT_ID=
# EBAY_SANDBOX_CLIENT_SECRET=
# EBAY_SANDBOX_RUNAME=
# EBAY_PRODUCTION_CLIENT_ID=
# EBAY_PRODUCTION_CLIENT_SECRET=
# EBAY_PRODUCTION_RUNAME=
# EBAY_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# SUPABASE_SERVICE_ROLE_KEY=
