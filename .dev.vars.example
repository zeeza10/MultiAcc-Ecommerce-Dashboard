# Local Wrangler runtime variables. Copy to .dev.vars for local development.
# Never commit .dev.vars or put real secrets in this example file.
API_ORIGIN=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# Seller OAuth token encryption key: Base64 encoding of exactly 32 random bytes.
# This remains server-only and is separate from the platform credential vault key.
# EBAY_TOKEN_ENCRYPTION_KEY=

# Platform Integration credential vault encryption key: Base64 encoding of exactly 32 random bytes.
# Used by the Super Admin module to encrypt eBay App ID, Cert ID and RuName before database storage.
# INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=

# Supabase service credential is also server-only and must be configured as a Worker Secret.
# SUPABASE_SERVICE_ROLE_KEY=

# Non-secret reference values (already configured in wrangler.jsonc where applicable):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<public-publishable-key>
